# Copy this file to .env and fill in the paths for your system.
# Source it before running scripts: source .env
# Or add the exports to your ~/.bashrc / SLURM submit script.

# Required: input data files
export MHW_DATA_FILE=/path/to/merged_daily.nc
export MHW_CLIM_FILE=/path/to/sst_climatology_doy.nc

# Optional: where experiment outputs are saved (default: ./experiments)
export MHW_EXPERIMENTS_DIR=/path/to/experiments

# Weights & Biases — required for train.py and train_partition.py
export WANDB_ENTITY=your-wandb-entity
export WANDB_PROJECT=mhw-precursors
# Optional: set to "offline" if compute nodes have no internet (sync later with wandb sync)
# export WANDB_MODE=offline
